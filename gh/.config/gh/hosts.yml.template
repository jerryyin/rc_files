# Linux credential setup seeds the accounts permitted by the selected vault.
# gh owns active-account state after setup; use credentials --package gh --update
# only when deliberately resetting it to these defaults. Windows stores the same
# vault tokens in its credential store instead of rendering this file.
github.com:
    git_protocol: https
    users:
__GH_USERS__
    user: __GH_LOGIN__
    oauth_token: __GH_TOKEN__
