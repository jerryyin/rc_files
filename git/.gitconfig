[user]
  email = zhuoryin@amd.com
  name = jerryyin
[pager]
  branch = false
[core]
  excludesfile = ~/.gitignore
[push]
  autoSetupRemote = true
[alias]
  cmt = commit --signoff
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential
[include]
  path = ~/.config/git/platform.conf
